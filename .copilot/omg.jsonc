// oh-my-copilot project config for this repository (read by `omg factory run` from the base commit).
{
  "ship": {
    // Every check this repository's CI reports on a PR to dev or main (ci.yml, pr-check.yml). A safety key: honoured
    // from the base commit of a trusted base (and the user config), never from the working tree or a PR head. The
    // built-in default names nothing (the forge's required checks, else every reported check); a drift test keeps
    // this list equal to OMG_REPOSITORY_REQUIRED_CHECKS (src/ship/config.ts) and to ci.yml's job names.
    "requiredChecks": [
      "Lint & Type Check",
      "Test",
      "Test (Windows path suite)",
      "better-sqlite3 Node 26 (ubuntu-latest)",
      "better-sqlite3 Node 26 (windows-2022)",
      "PreCompact restore (ubuntu-latest)",
      "PreCompact restore (macos-latest)",
      "PreCompact restore (windows-2022)",
      "Multi-repo Path Gate (AST-grep) (ubuntu-latest)",
      "Multi-repo Path Gate (AST-grep) (windows-2022)",
      "Version Consistency Check",
      "Build",
      "npm pack + install test",
      "Copilot smoke (tier 2)",
      "Base Branch Check",
      "Size Check",
      "Draft PR Check",
      "omg update + session-start hook",
      "Statechart suite (Node 24)"
    ]
  },
  "factory": {
    "run": {
      "secretScan": {
        // The test files that hold token-shaped fixture values (built at run time where they can be), found by running
        // the lane-commit secret scan over the tracked tree. Exact files only: a broad glob would let a lane commit a
        // real secret anywhere under it unscanned.
        "allowPaths": [
          "src/__tests__/copilot-notification-hook.test.ts",
          "src/factory/heal/__tests__/debug.test.ts",
          "src/factory/run/__tests__/lane-commit.staging.test.ts",
          "src/factory/run/__tests__/sandbox-exec.test.ts",
          "src/factory/setup/__tests__/e2e.test.ts",
          "src/notifications/__tests__/redact.test.ts",
          "src/smoke/replay/__tests__/redact.test.ts",
          "dist/__tests__/copilot-notification-hook.test.js",
          "dist/factory/heal/__tests__/debug.test.js",
          "dist/factory/run/__tests__/lane-commit.staging.test.js",
          "dist/factory/run/__tests__/sandbox-exec.test.js",
          "dist/factory/setup/__tests__/e2e.test.js",
          "dist/notifications/__tests__/redact.test.js",
          "dist/smoke/replay/__tests__/redact.test.js"
        ]
      }
    }
  }
}
